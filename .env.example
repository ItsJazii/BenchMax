# Public browser configuration.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=
# Required, distinct HTTPS origin on a separate cookieless site. Public
# evidence URLs point here and never fall back to the main application.
NEXT_PUBLIC_USERCONTENT_ORIGIN=

# Server-only authentication values. Store as encrypted runtime secrets.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=
BENCHMAX_OWNER_SUBJECTS=
# Base64-encoded 32-byte AES-GCM key for private provenance envelopes.
PROVENANCE_ENCRYPTION_KEY=

# Optional direct-to-R2 signing. Without these, authenticated Worker uploads
# still use the quarantine endpoint.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional isolated evaluator for compatible submitted source bundles.
E2B_API_KEY=
E2B_TEMPLATE_ID=
E2B_TEMPLATE_BUILD_HASH=

# Required by the current runtime. Phase 1 will make these values optional for a
# feed-only deployment; do not leave them blank until that code change lands. The
# pinned AI judge is the only model credential in BenchMax. Provider is a supported
# vendor id (`moonshot` for Kimi or `openai`). Activatable model versions must contain
# a dated immutable suffix such as `vendor-model-2026-08-07`; moving aliases such as
# `kimi-k2.7-code`, `kimi-k3`, and `*-latest` are calibration-only.
JUDGE_PROVIDER=
JUDGE_MODEL=
JUDGE_MODEL_VERSION=
JUDGE_API_ORIGIN=
JUDGE_API_KEY=
JUDGE_CALIBRATION_SET_HASH=
JUDGE_CALIBRATION_SET_OBJECT_KEY=
# Maximum judge samples that may be reserved per UTC day. Set this from the
# measured calibration-set cost before enabling AI reviews, not before feed-only
# submissions.
BENCHMAX_JUDGE_DAILY_SAMPLE_BUDGET=
# Explicit runtime pricing snapshots used for auditable per-result spend.
# Values are integer millionths of one US dollar; update them when vendor
# pricing changes. Benchmax never hard-codes a provider price.
BENCHMAX_JUDGE_INPUT_MICROUSD_PER_MILLION_TOKENS=
BENCHMAX_JUDGE_OUTPUT_MICROUSD_PER_MILLION_TOKENS=
BENCHMAX_SANDBOX_MICROUSD_PER_HOUR=

# User-content Worker only: exact HTTPS origin allowed to frame legacy
# playable archives. This must equal NEXT_PUBLIC_APP_URL.
BENCHMAX_APP_ORIGIN=
