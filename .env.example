# Public Clerk application identifier (safe for the browser).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_USERCONTENT_ORIGIN=

# Server-only authentication values. Store as encrypted runtime secrets.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=
BENCHMAX_OWNER_SUBJECTS=

# Optional direct-to-R2 signing. If absent, uploads use the authenticated
# Worker quarantine endpoint and still fail closed.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# M2 only: admin-granted platform generation provider.
MOONSHOT_PLATFORM_API_KEY=
E2B_API_KEY=
E2B_TEMPLATE_ID=
# Exact /opt/benchmax/environment.sha256 value from the built E2B template.
E2B_TEMPLATE_BUILD_HASH=
JUDGE_PROVIDER=
JUDGE_MODEL=
JUDGE_MODEL_VERSION=
JUDGE_API_ORIGIN=
JUDGE_API_KEY=
JUDGE_CALIBRATION_SET_HASH=
JUDGE_CALIBRATION_SET_OBJECT_KEY=
PROVENANCE_ENCRYPTION_KEY=
BENCHMAX_APP_ORIGIN=
