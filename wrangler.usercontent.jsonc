{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "benchmax-usercontent-local",
  "main": "usercontent/worker.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "benchmax-d1",
      // Fail-closed placeholder — see wrangler.jsonc; remote ops require --env.
      "database_id": "00000000-0000-4000-8000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "benchmax-local-uploads"
    }
  ],
  "env": {
    "staging": {
      "name": "benchmax-usercontent-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "benchmax-staging-d1",
          "database_id": "b5f6150a-7160-4ce7-bd87-2a9038683019"
        }
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS",
          "bucket_name": "benchmax-uploads-staging"
        }
      ]
    },
    "production": {
      "name": "benchmax-usercontent",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "benchmax-d1",
          "database_id": "b3947917-6bd5-4a92-a0ec-40f583acdb08"
        }
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS",
          "bucket_name": "benchmax-uploads"
        }
      ]
    }
  }
}
